  <diagram id="ldc-db-index" name="00 DATABASE INDEX">
    <mxGraphModel dx="2000" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="DATABASE MAP — CURRENT vs TARGET" style="rounded=1;fillColor=#16385a;strokeColor=#16385a;fontColor=#ffffff;fontSize=30;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="40" width="1900" height="72" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="CURRENT IMPLEMENTED&#xA;SQL Server 2022&#xA;LongevityDietDb&#xA;3 tables: Users / UserProfiles / RefreshTokens&#xA;1 DbContext, one SQL database" style="rounded=1;fillColor=#dceaf7;strokeColor=#3b6b9b;fontSize=22;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="915" height="235" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="TARGET ARCHITECTURE (NOT YET IMPLEMENTED)&#xA;Six logical service-owned SQL databases&#xA;33 canonical logical table types, distributed by owner&#xA;No cross-database foreign keys or shared DbContext" style="rounded=1;fillColor=#e1f3e8;strokeColor=#418865;fontSize=22;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1075" y="175" width="915" height="235" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Identity SQL&#xA;7 entities" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="515" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="Catalog SQL&#xA;8 entities" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="565" y="515" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Planning SQL&#xA;7 entities" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1055" y="515" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Tracking SQL&#xA;7 entities" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1545" y="515" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Recommendation SQL&#xA;1 canonical + proposed" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="760" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="Worker SQL&#xA;3 canonical + proposed" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="750" y="760" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="Cloudflare D1&#xA;PROPOSED seventh store" style="rounded=1;fillColor=#f6f8fb;strokeColor=#87a4bf;fontSize=23;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1425" y="760" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="Interpretation: 7 + 8 + 7 + 7 + 1 + 3 = 33 distinct table definitions from the assignment documentation. Outbox / inbox tables are copied to every producer or consumer service as required. Cloudflare D1 is an additional FUTURE proposal and is not part of the current six SQL DBs." style="rounded=1;fillColor=#fff6e8;strokeColor=#ddbf83;fontSize=19;whiteSpace=wrap;align=center;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="1930" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="Sources: docs/06-DATABASE-DESIGN.md; docs/assignment/03-DATA-MODEL.md; EF Core LongevityDietDbContext; ADR-005. Exact DDL exists only for the current 3 tables. Future fields are specified/proposed, NOT migrations." style="rounded=0;fillColor=none;strokeColor=none;fontColor=#34475c;fontSize=16;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="1255" width="1930" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
