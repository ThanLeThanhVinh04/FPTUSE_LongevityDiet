        <mxCell id="v128" value="• ProcessedEvents idempotent per consumer&#xA;• OutboxMessages owned by each producer, never one central database&#xA;• AuditLogs domain-owned; centralized ops events must not write foreign DB" style="rounded=1;arcSize=5;fillColor=#ecf2f8;strokeColor=#becfdf;fontColor=#273d54;fontSize=15;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="1125" width="1940" height="127" as="geometry" />
        </mxCell>
        <mxCell id="v129" value="WorkerJobs and DeadLetterEvents are design extensions. Worker must NEVER poll other services' Outbox directly." style="rounded=1;fillColor=#fff4e3;strokeColor=#f0c98a;fontColor=#6a4b25;fontSize=15;whiteSpace=wrap;html=0;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
